{
  "name": "shopify-inventory-mcp",
  "version": "0.2.3",
  "description": "MCP server: deterministic inventory forecasting tools over a Shopify store — local stdio BYOK or hosted HTTP with per-user Shopify headers. Not affiliated with Shopify.",
  "license": "MIT",
  "author": "Arsalan Arshad <arsalanarshad.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalan-arshad/shopify-inventory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/arsalan-arshad/shopify-inventory-mcp/issues"
  },
  "homepage": "https://github.com/arsalan-arshad/shopify-inventory-mcp#readme",
  "keywords": [
    "mcp",
    "shopify",
    "inventory",
    "forecast",
    "reorder",
    "stdio",
    "streamable-http"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/server.js",
  "bin": {
    "shopify-inventory-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
