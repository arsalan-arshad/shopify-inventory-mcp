# BYOK — never commit real values. Copy to .env and fill in.

# Required: your store’s *.myshopify.com domain
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# --- Auth: pick ONE of the two options below ---

# Option A — static Admin API token (legacy admin-created custom apps still work;
# Shopify no longer allows creating NEW ones). Without a token (or Option B),
# every tool call fails with a config error.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option B — Dev Dashboard app client credentials (recommended for new setups).
# Token is fetched via client_credentials grant (~24h lifetime; auto-refreshed).
# Comment out Option A and set both of these instead.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# Read-only scopes to grant the app:
#   read_inventory, read_locations, read_orders, read_products
# Optional: read_all_orders (protected) for history older than 60 days.

# Optional overrides (defaults shown)
# SHOPIFY_API_VERSION=2025-10
# LEAD_TIME_DAYS=21
# HISTORY_DAYS=30
# MAX_INVENTORY_ITEMS=2000
# MAX_ORDER_PAGES=24
