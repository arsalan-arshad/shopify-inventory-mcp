# Never commit real values. Copy to .env for *local* stdio (`npm start`).

# --- Local stdio BYOK ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A — static Admin API token (legacy custom apps)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option B — Dev Dashboard client credentials (recommended)
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# Scopes: read_inventory, read_locations, read_orders, read_products

# Optional
# SHOPIFY_API_VERSION=2025-10
# LEAD_TIME_DAYS=21
# HISTORY_DAYS=30
# MAX_INVENTORY_ITEMS=2000
# MAX_ORDER_PAGES=24

# --- Hosted HTTP only (`npm run start:http` / Railway) ---
# Shared gateway key. Clients send Authorization: Bearer <MCP_API_KEY>
# plus their own X-Shopify-* headers. Railway should NOT store SHOPIFY_*.
# MCP_API_KEY=
