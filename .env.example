# Never commit real values. Copy to .env for *local* stdio (`npm start`).

# --- Local stdio BYOK ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A — static Admin API token (legacy custom apps)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option B — Dev Dashboard client credentials (recommended)
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# Scopes: read_inventory, read_locations, read_orders, read_products

# Optional
# SHOPIFY_API_VERSION=2025-10
# LEAD_TIME_DAYS=21
# HISTORY_DAYS=30
# MAX_INVENTORY_ITEMS=2000
# MAX_ORDER_PAGES=24

# --- Hosted HTTP (`npm run start:http` / Railway) ---
# No MCP_API_KEY. Clients send X-Shopify-* headers with their own credentials.
# Railway does not need SHOPIFY_* env vars for multi-user BYOK.
